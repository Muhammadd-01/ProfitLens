# ==============================================================================
# ProfitLens Environment Variables (MongoDB Edition)
# ==============================================================================

# Application
APP_NAME=ProfitLens
APP_VERSION=0.1.0
DEBUG=false

# MongoDB / MongoDB Compass Connection
# Use mongodb://localhost:27017 for local MongoDB Compass
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=profitlens

# JWT Authentication
SECRET_KEY=profitlens-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
